{
  "name": "netflix-clone-fullstack",
  "version": "1.0.0",
  "description": "Full-stack Netflix clone with React + TypeScript frontend and Express + TypeScript backend",
  "main": "index.js",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "npm run dev --prefix server",
    "client:dev": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "server:build": "npm run build --prefix server",
    "client:build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "server:start": "npm start --prefix server",
    "client:preview": "npm run preview --prefix client"
  },
  "keywords": [
    "netflix",
    "clone",
    "react",
    "typescript",
    "express",
    "fullstack"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
