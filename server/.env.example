PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-string

# Bunny Stream (for your own films; see README "Hosting your own films")
# API key: Bunny dashboard -> Stream -> your library -> API. Keep it secret.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
# Pull zone host shown on the same page, e.g. vz-abc123.b-cdn.net
BUNNY_CDN_HOSTNAME=
